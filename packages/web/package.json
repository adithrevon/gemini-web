{
  "name": "gemini-web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"vite\" \"node server.mjs\"",
    "dev:debug": "concurrently \"vite --host 0.0.0.0\" \"GEMINI_WEB_DEBUG=1 GEMINI_WEB_CLI_LOG=1 node server.mjs\"",
    "build": "vite build",
    "start": "node server.mjs",
    "start:debug": "GEMINI_WEB_DEBUG=1 GEMINI_WEB_CLI_LOG=1 node server.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "typescript": "^5.6.3",
    "vite": "^6.0.5"
  }
}
